# ============ 必填 ============
# RedFox API Key（从 RedFox 平台获取）
REDFOX_API_KEY=your_redfox_api_key

# ============ LLM（选题生成、热点分析）============
# 任意 OpenAI Chat Completions 兼容服务
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# ============ 安全 ============
# 知识库凭证加密密钥（AES-256-GCM）
# 生成命令：openssl rand -hex 32
# 配置后请勿修改，否则已加密的数据无法解密
KB_ENCRYPTION_KEY=CHANGE_ME_TO_RANDOM_32_BYTES_HEX
# 浏览器插件上报令牌（extension/mp-stats 公众号后台数据同步用）
# 生成命令：openssl rand -hex 16；插件「选项」页填同样的值
INGEST_TOKEN=
# 微信公众平台官方数据统计（认证号可用，T+1 权威阅读数据，dashboard/文章分析自动使用）
# 公众平台 → 设置与开发 → 基本配置 获取；服务器 IP 必须加进同页「IP 白名单」，否则 token 接口报 40164
MP_APP_ID=
MP_APP_SECRET=
# 可选：该 AppID 对应「我的账号」里的哪个公众号名（多公众号时用于精确匹配）
MP_ACCOUNT_NAME=
# 可选：IP 白名单自动配置（dashboard「官方数据」40164 自救）使用的 Chrome 路径，缺省自动探测常见安装路径
# CHROME_PATH=/usr/bin/google-chrome

# ============ 服务 ============
HOST=0.0.0.0
PORT=8080
# RedFox API 主机，默认 redfox.hk
REDFOX_HOST=redfox.hk
# 启用数据库中的 CRON 任务
ENABLE_SCHEDULER=true
# 时区，影响 data_date 边界、cron 触发、Date 字段解读
# 默认 Asia/Shanghai（中文自媒体场景）；海外用户改成对应 IANA 名，如 America/New_York
# USER_TIMEZONE=Asia/Shanghai

# ============ 本地 Agent（默认从 PATH 查找）============
CODEX_BIN=codex
CLAUDE_BIN=claude
KIMI_BIN=kimi
# Agent adapter 三模式（详见 CLAUDE.md「Agent 接入」）：
#
# A. 本地映射（Linux 宿主 + Docker，推荐）
#    用 docker-compose.local-agents.yaml override：
#      docker compose -f docker-compose.yaml -f docker-compose.local-agents.yaml up
#    自动设 AGENT_ADAPTER=local 并挂宿主 ~/.npm-global / ~/.kimi-code / 凭证
#
# B. sbx microVM（Docker 通用，需要 sbx CLI）
#    默认 Docker 部署自动启用（检测 /.dockerenv）。需在容器内或宿主装 sbx：
#      https://docs.docker.com/ai/sandboxes/get-started/
#    sbx 自己管凭证（宿主 sbx login 一次）
#
# C. 容器内安装（跨架构/跨机器迁移）
#    Dockerfile 末尾加 npm i -g @anthropic-ai/claude-code ... 自己维护
#    镜像膨胀到 ~1.5 GB
#
# AGENT_ADAPTER=local|sbx 强制 override，比如 Docker 内走 local
# AGENT_ADAPTER=local
OPENCLAW_BIN=openclaw
HERMES_BIN=hermes

# ============ 可选 ============
# 查询 RedFox 官网账号剩余点数；填写浏览器登录后的完整 Cookie
REDFOX_WEB_COOKIE=
# Skill 中心社区更新走 GitHub API。未配置时匿名请求频率 60/hr 容易被 403 限流；
# 配置后提升到 5000/hr。Personal access token 即可，无需勾选任何权限（纯公开仓库读取）。
# 创建：https://github.com/settings/tokens → Generate new token → No scope
# GITHUB_API_TOKEN=ghp_xxx
# SQLite 文件路径，默认使用项目目录下的 cache.db
# CACHE_DB_PATH=/var/lib/insprira/cache.db
# 重启命令（默认检测 systemd；非 systemd 环境可指定，如 "pm2 restart insprira"）
# FURNACE_RESTART_CMD=

# 首次启动会在 SQLite 中创建默认账号 admin / 123456，登录后请立即修改密码
